#include "versal-scobc-v1-common.dtsi"

/ {
	model = "Space Cubics SC-OBC Module V1 Space Grade Rev.B";
	compatible = "sc,scobc-v1-revb", "sc,scobc-v1", "xlnx,versal";
};

&qspi {
	status = "okay";
	num-cs = <2>;

	/* CIPS uses Dual Stacked, but CS0 and CS1 are independent memories. */
	/delete-property/ is-stacked;
	/delete-property/ is-dual;

	/* Keep PLM fallback reads within the CS0 boot memory. */
	/delete-property/ xlnx,connection-mode;
	/delete-property/ xlnx,qspi-mode;
	xlnx,connection-mode = <0>;
	xlnx,qspi-mode = <0>;

	boot_memory: flash@0 {
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "avalanche,as301g208", "jedec,spi-nor";
		reg = <0>;
		spi-tx-bus-width = <1>;
		spi-rx-bus-width = <4>;
		spi-max-frequency = <40000000>;
	};

	hirel_memory: flash@1 {
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "avalanche,as3064204", "jedec,spi-nor";
		reg = <1>;
		spi-tx-bus-width = <1>;
		spi-rx-bus-width = <4>;
		spi-max-frequency = <40000000>;
	};
};

/ {
	emmc_vcc: regulator-emmc-vcc {
		compatible = "regulator-fixed";
		regulator-name = "emmc-vcc";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&gpio1 51 0>;
		enable-active-high;
		regulator-boot-on;
		startup-delay-us = <100000>;
		off-on-delay-us = <500000>;
	};
};

&sdhci1 {
	vmmc-supply = <&emmc_vcc>;
};
